{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "moduleResolution": "bundler",
        "isolatedModules": true,
        "outDir": "./dist"
    },
    "include": ["src/**/*.ts", "testing/**/*.ts", "*.config.ts"],
    "exclude": ["node_modules", "dist"]
}
