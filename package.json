{
    "name": "substract",
    "version": "1.1.0",
    "description": "A NodeJS library for extracting hard-coded subtitles from within videos.",
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "type": "module",
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "lint": "biome ci .",
        "format": "biome check --write .",
        "evaluate:corpus": "tsx testing/evaluate-corpus.ts",
        "test": "vitest run --coverage",
        "test:e2e": "vitest run --config vitest.e2e.config.ts"
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "p-limit": "^7.3.3",
        "pino": "^10.4.0",
        "pixelmatch": "^7.2.0",
        "sharp": "^0.35.5",
        "string-similarity-js": "^2.1.4"
    },
    "engines": {
        "node": ">=22.18.0"
    },
    "keywords": [
        "srt",
        "subtitle",
        "subtitles",
        "video",
        "nodejs"
    ],
    "author": "Ragaeeb Haq",
    "license": "MIT",
    "devDependencies": {
        "@semantic-release/changelog": "^7.0.0",
        "@types/node": "^26.6.4",
        "@vitest/coverage-v8": "^5.0.3",
        "semantic-release": "^25.0.9",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3",
        "@biomejs/biome": "2.5.15",
        "tsdown": "^0.23.0",
        "tsx": "^4.23.15"
    }
}
